# ==============================================================================
# Python & AI Services .gitignore
# ==============================================================================

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
bin/
lib/
include/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution & Build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
coverage.xml
*.cover

# Environment variables & secrets (Never commit secrets)
.env
.env.*
.env.local
.env.development
.env.production
.env.test
!.env.example
!.env.template

# SQLite & Databases
*.db
*.db-journal
*.sqlite
*.sqlite3
confidence_ai.db

# Uploads & temporary media files (Keep folder structure via .gitkeep)
uploads/*
!uploads/.gitkeep
temp/
tmp/
temp_audio/
temp_video/
*.wav
*.mp3
*.mp4
*.m4a
*.webm
*.ogg
*.flac
*.aac

# AI Models, Weights & HuggingFace / Faster-Whisper Cache
models/
whisper_models/
.cache/
hf_cache/
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.engine
*.tflite

# Logs
logs/
*.log

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System
.DS_Store
Thumbs.db
