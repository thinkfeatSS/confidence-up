# ==============================================================================
# ROOT .gitignore - Confidence Builder Project
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL SECRETS & CREDENTIALS (Never push to GitHub)
# ------------------------------------------------------------------------------
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
!.env.example
!.env.template
!**/.env.example
!**/.env.template

# Google, Firebase & Cloud Service Account Keys
client_secret_*.json
*firebase-adminsdk*.json
google-services*.json
google-services.json
GoogleService-Info.plist
*secret*
*credential*
New Text Document.txt
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.keystore
*.jks

# ------------------------------------------------------------------------------
# 2. PYTHON & AI SERVICES (FastAPI, PyTorch, Whisper, SQLite)
# ------------------------------------------------------------------------------
**/__pycache__/
**/*.py[cod]
*$py.class
**/.venv/
**/venv/
**/env/
**/ENV/
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.tox/
**/.hypothesis/

# SQLite & Databases
*.db
*.db-journal
*.sqlite
*.sqlite3
**/confidence_ai.db

# AI Models, Weights & HuggingFace / Faster-Whisper Cache
**/models/
**/whisper_models/
**/.cache/
**/hf_cache/
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.engine
*.tflite

# Uploads & Temporary Media Files
**/uploads/*
!**/uploads/.gitkeep
**/temp/
**/tmp/
**/temp_audio/
**/temp_video/
*.wav
*.mp3
*.mp4
*.m4a
*.webm
*.ogg
*.flac
*.aac

# ------------------------------------------------------------------------------
# 3. NODE.JS, NEXT.JS & NESTJS (API & Web)
# ------------------------------------------------------------------------------
**/node_modules/
**/dist/
**/build/
**/.next/
**/out/
**/.vercel/
**/.turbo/
**/.pnp
**/.pnp.*
**/*.tsbuildinfo
**/next-env.d.ts
**/generated/prisma

# ------------------------------------------------------------------------------
# 4. REACT NATIVE & MOBILE APP (iOS / Android)
# ------------------------------------------------------------------------------
# Android
app/android/app/build/
app/android/build/
app/android/.gradle/
app/android/local.properties
app/android/.cxx/
*.apk
*.aab

# iOS
app/ios/Pods/
app/ios/build/
app/ios/DerivedData/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
*.ipa

# Fastlane / Bundler
.bundle/
vendor/bundle/

# ------------------------------------------------------------------------------
# 5. LOGS & DIAGNOSTICS
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------------------------------------------
# 6. DOCKER & CONTAINER OVERRIDES
# ------------------------------------------------------------------------------
docker-compose.override.yml

# ------------------------------------------------------------------------------
# 7. OS & IDE ARTIFACTS
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDEs
.idea/
*.sublime-workspace
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
