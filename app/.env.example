# Copy to .env.local for local overrides (optional)

# Production (default for release APK / Vercel)
API_BASE_URL=http://binaryunit.tech/api/v1

# Local backend (debug builds use .env.development automatically)
# API_BASE_URL=http://10.0.2.2:3000/api/v1

GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Ollama AI (speech analysis + AI Coach) — configured on the API server, not in the app.
# Set OLLAMA_BASE_URL and OLLAMA_MODEL in api/.env. See api/.env.example
