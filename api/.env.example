# Google Gemini — speech AI analysis + AI Coach chat
# Get a key: https://aistudio.google.com/apikey
# Set in Hostinger hPanel → Node.js app → Environment variables (NOT only in this file on server)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Hostinger SMTP (email OTP, contact form, weekly reports)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=info@thinkfeat.com
MAIL_PASSWORD=your-mailbox-password
MAIL_FROM_NAME=ConfidenceUp
MAIL_FROM_ADDRESS=info@thinkfeat.com
