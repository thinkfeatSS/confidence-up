# Ollama Local LLM — speech AI analysis + AI Coach chat
# Ollama service runs on http://ollama:11434 (Docker) or http://127.0.0.1:11434 (Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Hostinger SMTP (email OTP, contact form, weekly reports)
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=info@thinkfeat.com
MAIL_PASSWORD=your-mailbox-password
MAIL_FROM_NAME=SpeakUpMic
MAIL_FROM_ADDRESS=info@thinkfeat.com
